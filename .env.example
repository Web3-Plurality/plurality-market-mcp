# =====================================================================
# plurality-market-mcp — example env. Copy to .env and fill in.
# Same shape as prod's mcp; just point at the new market-* services.
# =====================================================================

# Public-facing URL for THIS MCP server (distinct port from prod's 5050)
MCP_RESOURCE_URL=http://localhost:5051

# Backend API (market-backend, NOT prod backend)
BACKEND_API_URL=http://localhost:5001

# Dev-only CORS. Set to the marketplace UI origin (e.g. http://localhost:3001)
# when running the MCP without Traefik in front of it. Leave EMPTY in prod —
# Traefik handles CORS, and double-CORS produces duplicate headers that
# browsers reject.
MCP_DEV_CORS_ORIGIN=
